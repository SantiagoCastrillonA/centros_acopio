# Copiar a /var/www/centros_acopio/.env y completar.
# Este archivo es un ejemplo y SI se versiona; el .env real NO.
#
# La clave se genera en el servidor con:  php artisan key:generate

APP_NAME="Centros de acopio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://CAMBIE_POR_SU_DOMINIO_O_IP

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=centros_acopio
DB_USERNAME=centros_acopio
DB_PASSWORD=CAMBIE_POR_UNA_CONTRASENA_LARGA

# Sin Redis: la VM del nivel gratuito tiene 1 GB y no sobra memoria.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Poner en true SOLO cuando el dominio ya tenga certificado HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
